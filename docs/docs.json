{
  "$schema": "https://mintlify.com/docs.json",

  "theme": "almond",
  "name": "VideoCull",

  "description": "VideoCull is a free and open-source Windows app for quickly sorting and culling large video collections using multiple thumbnails per video and keyboard-first Keep, Delete, and Skip controls.",

  "seo": {
    "indexing": "navigable",
    "metatags": {
      "robots": "index, follow",
      "googlebot": "index, follow"
    }
  },

  "search": {
    "prompt": "Search VideoCull documentation..."
  },

  "metadata": {
    "timestamp": true
  },
  "colors": {
    "primary": "#8b7af0",
    "light": "#a596f7",
    "dark": "#24223d"
  },
  "logo": "icon.png",
  "favicon": "icon.png",
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://videocull.app"
      },
      {
        "type": "github",
        "href": "https://github.com/StippieDot/VideoCull"
      }
    ]
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "getting-started/index",
          "getting-started/introduction",
          "features/sessions-and-folders",
          "getting-started/installation",
          "getting-started/quickstart"
        ]
      },
      {
        "group": "Features",
        "pages": [
          "features/grid-view",
          "features/review-mode",
          "features/duplicate-review",
          "features/delete-and-safety"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/settings",
          "reference/cache-and-processing",
          "reference/keyboard-shortcuts",
          "reference/supported-formats",
          "reference/building-from-source"
        ]
      },
      {
        "group": "Help",
        "pages": [
          "help/faq",
          "help/troubleshooting"
        ]
      }
    ]
  }
}
