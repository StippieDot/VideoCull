{
  "name": "videocull",
  "version": "2.5.0",
  "description": "High-performance video culling tool for managing large video collections",
  "author": "StippieDot",
  "license": "AGPL-3.0-only",
  "main": "electron/bootstrap.js",
  "desktopName": "videocull.desktop",
  "scripts": {
    "postinstall": "install-electron && node scripts/fetch-ffmpeg.js",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.js",
    "dev:vite": "vite",
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "check:ipc": "node scripts/check-ipc-contract.js",
    "check:installer": "node scripts/check-installer-config.js",
    "check:store": "node scripts/check-store-config.js",
    "check:store:strict": "node scripts/check-store-config.js --strict",
    "validate:store-package": "node scripts/validate-store-package.js",
    "verify:store-installed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-installed-store-package.ps1",
    "check:brand": "node scripts/check-brand.js",
    "test": "vitest run",
    "test:renderer": "vitest run -c config/vitest.renderer.config.ts",
    "test:watch": "vitest",
    "test:cache-native": "node scripts/run-electron-node-tests.js tests/electron/cache.test.js tests/electron/cache.migration.test.js",
    "test:packaging": "node --test tests/electron/build-hooks.test.js tests/electron/generate-notices.test.js tests/electron/fetch-ffmpeg.test.js",
    "coverage": "vitest run --coverage",
    "test:profile": "node --test tests/electron/profile-bootstrap.test.js tests/electron/storage-compatibility.test.js",
    "test:store": "node --test tests/electron/store-*.test.js",
    "test:ci": "npm run check:ipc && npx tsc -p config/tsconfig.electron.json && npm run check:installer && npm run check:store && npm run check:brand && npm run test:packaging && npm run test:profile && npm run test:store && npx tsc -p config/tsconfig.test.json --noEmit && npm run coverage",
    "test:e2e": "npm run build && playwright test",
    "test:duplicates": "vitest run tests/electron/duplicate-utils.test.js tests/electron/duplicates.test.js tests/electron/duplicate-worker.test.js tests/electron/visual-worker.test.js",
    "stress:cache-overcap": "node scripts/cache-overcap-smoke.js",
    "cleanup:cache": "node scripts/cleanup-cache-clutter.js",
    "package": "vite build && electron-builder --win --publish never",
    "package:mac": "vite build && node scripts/fetch-ffmpeg.js darwin-arm64 darwin-x64 && electron-builder --mac --publish never",
    "package:linux": "vite build && electron-builder --linux --publish never",
    "package:store": "node scripts/package-store.js"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0"
    }
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "@videojs/react": "^10.2.0",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-window": "^2.5.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "^45.2.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "follow-redirects": "^1.16.0"
  },
  "build": {
    "appId": "com.videocull.app",
    "productName": "VideoCull",
    "directories": {
      "output": "artifacts/packages"
    },
    "files": [
      "artifacts/renderer/**/*",
      "electron/**/*",
      "product.json",
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "vendor/ffmpeg/${platform}-${arch}",
        "to": "ffmpeg",
        "filter": [
          "**/*",
          "!.toolchain-sha256"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.{exe,dll,dylib,so,node}",
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "afterPack": "./scripts/electron-builder-hooks.js",
    "win": {
      "target": "nsis",
      "icon": "build/videocull.ico",
      "executableName": "VideoCull",
      "artifactName": "VideoCull.Setup.${version}.${ext}",
      "files": [
        "!node_modules/better-sqlite3/prebuilds/{darwin,linux,linuxmusl}-*.node",
        "!node_modules/better-sqlite3/prebuilds/win32-arm64.node"
      ],
      "extraResources": [
        {
          "from": "build/videocull.ico",
          "to": "videocull.ico"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "src/assets/videocull-icon.png",
      "category": "public.app-category.video",
      "identity": "-",
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "VideoCull reads the video folders you open on your Desktop.",
        "NSDocumentsFolderUsageDescription": "VideoCull reads the video folders you open in Documents.",
        "NSDownloadsFolderUsageDescription": "VideoCull reads the video folders you open in Downloads.",
        "NSRemovableVolumesUsageDescription": "VideoCull reads the video folders you open on external drives.",
        "NSNetworkVolumesUsageDescription": "VideoCull reads the video folders you open on network drives."
      },
      "artifactName": "VideoCull-${version}-${arch}.${ext}",
      "files": [
        "!node_modules/better-sqlite3/prebuilds/{win32,linux,linuxmusl}-*.node"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/videocull-icon.png",
      "category": "AudioVideo",
      "maintainer": "StippieDot",
      "vendor": "StippieDot",
    "extraResources": [
      {
        "from": "src/assets/videocull-icon.png",
        "to": "videocull.png"
      }
    ],
      "executableName": "videocull",
      "syncDesktopName": true,
      "artifactName": "VideoCull-${version}-${arch}.${ext}",
      "files": [
        "!node_modules/better-sqlite3/prebuilds/{win32,darwin,linuxmusl}-*.node",
        "!node_modules/better-sqlite3/prebuilds/linux-arm64.node"
      ]
    },
    "rpm": {
      "fpm": [
        "--directories=/opt/VideoCull"
      ]
    },
    "appx": {
      "applicationId": "VideoCull",
      "identityName": "StippieDot.VideoCull",
      "publisher": "CN=6A4B6EC8-38EB-4378-A661-8B04B8C7A5A3",
      "publisherDisplayName": "StippieDot",
      "displayName": "VideoCull",
      "languages": [
        "en-US"
      ],
      "capabilities": [
        "runFullTrust",
        "unvirtualizedResources"
      ],
      "customManifestPath": "appx/AppxManifest.xml",
      "minVersion": "10.0.19045.0",
      "maxVersionTested": "10.0.26100.0",
      "setBuildNumber": false,
      "artifactName": "VideoCull.Store.${version}.x64.${ext}",
      "showNameOnTiles": false
    },
    "publish": {
      "provider": "github",
      "owner": "StippieDot",
      "repo": "VideoCull"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "VideoCull",
      "uninstallDisplayName": "VideoCull ${version}",
      "installerIcon": "build/videocull.ico",
      "uninstallerIcon": "build/videocull.ico",
      "include": "build/installer.nsh",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp"
    }
  }
}
