+  text-align: right;
+}
+
+.duplicate-sidebar-view-toggle {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 4px;
+  padding: 3px;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  background: var(--bg-surface);
+}
+
+.duplicate-sidebar-view-toggle button {
+  display: inline-flex;
+  align-items: center;
