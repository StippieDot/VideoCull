+  background: rgba(255, 255, 255, 0.018);
+}
+
+.duplicate-sidebar-heading-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+}
+
+.duplicate-sidebar-field {
+  display: grid;
+  gap: 5px;
+}
+
+.duplicate-sidebar-field > span {
+  color: var(--text-tertiary);
+  font-size: 10px;
+  font-weight: 600;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.duplicate-sidebar-field input[type="text"] {
+  width: 100%;
+  min-height: 32px;
+  box-sizing: border-box;
+  padding: 0 9px;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-sm);
+  background: var(--bg-surface);
+  color: var(--text-primary);
+  font-size: 12px;
+}
+
+.duplicate-sidebar-field input[type="text"]:focus {
+  outline: none;
+  border-color: var(--accent);
+}
+
+.duplicate-sidebar-inline {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 42px;
+  align-items: center;
+  gap: 8px;
+}
+
+.duplicate-sidebar-inline input[type="range"] {
+  width: 100%;
+  accent-color: var(--accent);
+}
+
+.duplicate-sidebar-inline strong {
+  color: var(--text-secondary);
+  font-size: 12px;
+  text-align: right;
+  font-variant-numeric: tabular-nums;
+}
