+/* Duplicates tab */
+.duplicates-settings {
+  gap: 20px;
+}
+
+.duplicates-enable-row {
+  display: flex;
+  align-items: center;
+  width: 100%;
+  padding: 14px 16px;
+  border: 1px solid var(--border-color);
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.025);
+  cursor: pointer;
+  transition: border-color 0.15s ease, background 0.15s ease;
+}
+
+.duplicates-enable-row:hover,
+.duplicates-enable-row.active {
+  background: rgba(255, 255, 255, 0.045);
+}
+
+.duplicates-enable-row.active {
+  border-color: color-mix(in srgb, var(--accent) 62%, var(--border-color));
+}
+
+.duplicates-enable-main {
+  display: flex;
+  align-items: flex-start;
+  gap: 12px;
+  width: 100%;
+}
+
+.duplicates-enable-main input {
+  margin-top: 2px;
+}
+
+.duplicates-enable-copy {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.duplicates-enable-title {
+  color: var(--text-primary);
+  font-size: 14px;
+  font-weight: 600;
+}
+
+.duplicates-section {
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+}
+
+.duplicates-section.settings-section-divider {
+  border-top: 1px solid var(--border-color);
+  padding-top: 18px;
+}
+
+.duplicates-section-heading {
+  display: flex;
+  flex-direction: column;
+  gap: 5px;
+}
+
+.duplicates-control-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 16px;
+}
+
+.duplicates-control-grid .form-group {
+  min-width: 0;
+  padding: 12px;
+  border: 1px solid var(--border-color);
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.02);
+}
+
+.duplicates-control-grid .form-group select {
+  width: 100%;
+}
+
+.duplicates-control-grid .duplicates-span-full {
+  grid-column: 1 / -1;
+}
+
+.duplicates-inline-value {
+  min-height: 36px;
+  gap: 10px;
+}
+
+.duplicates-inline-value span {
+  color: var(--text-secondary);
+  font-size: 13px;
+  white-space: nowrap;
+}
+
+.duplicates-toggle-list {
+  display: grid;
+  gap: 10px;
+}
+
+.duplicates-toggle-list.advanced {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.duplicates-toggle-row {
+  min-width: 0;
+  padding: 12px;
+  border: 1px solid var(--border-color);
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.02);
+  transition: background 0.15s ease, border-color 0.15s ease;
+}
+
+.duplicates-toggle-row:hover {
+  background: rgba(255, 255, 255, 0.04);
+  border-color: rgba(255, 255, 255, 0.16);
+}
+
+.duplicates-toggle-row label {
+  align-items: flex-start;
+  line-height: 1.35;
+}
+
+.duplicates-toggle-row input {
+  margin-top: 2px;
+}
+
+.duplicates-keeper-order {
+  display: grid;
+  gap: 10px;
+  padding: 12px;
+  border: 1px solid var(--border-color);
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.02);
+}
+
+.duplicates-keeper-heading {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.duplicates-keeper-heading h4 {
+  margin: 0 0 4px;
+  color: var(--text-primary);
+  font-size: 13px;
+  font-weight: 650;
+}
+
+.duplicates-keeper-list {
+  display: grid;
+  gap: 7px;
+}
+
+.duplicates-keeper-row {
+  display: grid;
+  grid-template-columns: 24px minmax(0, 1fr) auto;
+  align-items: center;
+  gap: 10px;
+  min-height: 44px;
+  padding: 7px 8px;
+  border: 1px solid var(--border-color);
+  border-radius: 7px;
+  background: rgba(0, 0, 0, 0.12);
+}
+
+.duplicates-keeper-rank {
+  display: grid;
+  place-items: center;
+  width: 22px;
+  height: 22px;
+  border-radius: 6px;
+  background: rgba(142, 117, 255, 0.16);
+  color: var(--accent);
+  font-size: 12px;
+  font-weight: 700;
+}
+
+.duplicates-keeper-copy {
+  display: grid;
+  gap: 2px;
+  min-width: 0;
+}
+
+.duplicates-keeper-copy strong {
+  color: var(--text-primary);
+  font-size: 13px;
+}
+
+.duplicates-keeper-copy span {
+  color: var(--text-tertiary);
+  font-size: 12px;
+}
+
+.duplicates-keeper-actions {
+  display: inline-flex;
+  gap: 5px;
+}
+
+.duplicates-keeper-actions button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 28px;
+  height: 28px;
+  border: 1px solid var(--border-color);
+  border-radius: 6px;
+  color: var(--text-secondary);
+}
+
+.duplicates-keeper-actions button:hover:not(:disabled) {
+  color: var(--text-primary);
+  border-color: var(--border-hover);
+  background: var(--bg-surface-hover);
+}
+
+.duplicates-keeper-actions button:disabled {
+  cursor: not-allowed;
+  opacity: 0.4;
+}
+
+.duplicates-custom-window {
+  padding: 12px;
+  border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border-color));
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.025);
+}
+
+.duplicates-maintenance-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 12px;
+  border: 1px solid var(--border-color);
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.02);
+}
+
+.duplicates-maintenance-row > div {
+  display: flex;
+  align-items: baseline;
+  gap: 6px;
+  min-width: 0;
+}
+
+.duplicates-clear-btn {
+  flex-shrink: 0;
+  min-height: 32px;
+  padding: 0 11px;
+  border: 1px solid var(--border-color);
+  border-radius: 7px;
+  color: var(--text-secondary);
+  font-size: 12px;
+  font-weight: 600;
+}
+
+.duplicates-clear-btn:hover:not(:disabled) {
+  color: var(--text-primary);
+  border-color: var(--border-hover);
+  background: var(--bg-surface-hover);
+}
+
+.duplicates-clear-btn:disabled {
+  cursor: not-allowed;
+  opacity: 0.5;
+}
+
+@media (max-width: 760px) {
+  .duplicates-control-grid,
+  .duplicates-toggle-list.advanced {
+    grid-template-columns: 1fr;
+  }
+
+  .duplicates-maintenance-row {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+}
